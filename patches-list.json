          }
        },
        {
          "key": "hdcpLevel",
          "title": "HDCP level to report",
          "description": "HDCP_V2_2 is required for 4K content on most streaming apps.",
          "required": false,
          "type": "kotlin.String",
          "default": "HDCP_V2_2",
          "values": {
            "HDCP 2.2": "HDCP_V2_2",
            "HDCP 2.3": "HDCP_V2_3",
            "HDCP 1.x": "HDCP_V1",
            "None (disable)": "HDCP_LEVEL_NONE"
          }
        }
      ]
    },

    {
      "name": "Spoof Widevine / DRM level",
      "description": "Reports Widevine L1 (hardware DRM) to apps that check DRM level locally.\n\nUseful for apps that refuse to play HD/4K content on L3 devices or after re-signing.\n\nDoes not bypass server-side DRM - Netflix, Disney+ and similar are not affected.",
      "default": false,
      "dependencies": [],
      "compatiblePackages": null,
      "options": [
        {
          "key": "securityLevel",
          "title": "Widevine security level to report",
          "description": "L1 = hardware DRM (highest quality). L3 = software only. Default L1.",
          "required": true,
          "type": "kotlin.String",
          "default": "L1",
          "values": {
            "L1 (highest — hardware)": "L1",
            "L2": "L2",
